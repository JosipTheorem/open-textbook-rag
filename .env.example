# Copy this file to .env if you want to change the local defaults.
# Never commit .env because it can contain private credentials.

POSTGRES_DB=textbook_rag
POSTGRES_USER=textbook_rag
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://textbook_rag:local-development-only@localhost:5432/textbook_rag
