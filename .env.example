# Copy this file to .env before running the project.
# Never commit .env because it can contain private credentials.
# If you change the PostgreSQL settings, update DATABASE_URL to match.
# If you change OLLAMA_LLM_PORT, update OLLAMA_LLM_URL to match.

POSTGRES_DB=textbook_rag
POSTGRES_USER=textbook_rag
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://textbook_rag:local-development-only@127.0.0.1:5432/textbook_rag
OLLAMA_LLM_URL=http://127.0.0.1:11435
OLLAMA_LLM_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_LLM_PORT=11435
OLLAMA_LLM_CONTEXT_LENGTH=16384
LANGSMITH_TRACING=false
VOICE_ASR_WS=ws://127.0.0.1:8080/v1/audio/transcriptions/realtime
